{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust Office Modern",
  "version": "0.4.1",
  "identifier": "dev.rustoffice.modern",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Rust Office Modern",
        "width": 1440,
        "height": 900,
        "minWidth": 950,
        "minHeight": 600,
        "backgroundColor": "#f5f7fb"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Modern Rust Office desktop",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}